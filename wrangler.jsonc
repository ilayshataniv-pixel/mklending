{
  "name": "mklending",
  "main": "worker.mjs",
  "compatibility_date": "2026-11-05",
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": ["/api/*"] },
  "ratelimits": [{ "name": "BOOKING_LIMITER", "namespace_id": "1001", "simple": { "limit": 3, "period": 60 } }, { "name": "ADMIN_LIMITER", "namespace_id": "1002", "simple": { "limit": 20, "period": 60 } }],
  "vars": { "TELEGRAM_USERNAME": "", "PRICE_60": "", "PRICE_90": "" }
}
