{
  "name": "mklending",
  "main": "worker.mjs",
  "compatibility_date": "2026-11-05",
  "build": { "command": "node prepare.mjs" },
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": true, "html_handling": "none" },
  "ratelimits": [
    { "name": "BOOKING_LIMITER", "namespace_id": "1001", "simple": { "limit": 3, "period": 60 } },
    { "name": "ADMIN_LIMITER", "namespace_id": "1002", "simple": { "limit": 20, "period": 60 } },
    { "name": "AUTH_LIMITER", "namespace_id": "1003", "simple": { "limit": 8, "period": 60 } }
  ],
  "d1_databases": [
    { "binding": "DB", "database_name": "mklending-schedule", "database_id": "00000000-0000-4000-8000-000000000000" }
  ],
  "vars": { "PAGES_ORIGIN": "https://ilayshataniv-pixel.github.io", "PRICE_60": "", "PRICE_90": "", "PRICE_TRIAL": "" }
}
